    public void encryptFile (File f) throws IOException {
        BigInteger fileData = concatenate( getFileTxt(f) );
        BigInteger message = fileData.modPow( this.encryptionKey, this.modulusN );
        setFileTxt( f, bigIntToChars( message ) );

    }

    public void decryptFile (File f) throws IOException {
        BigInteger fileData = concatenate( getFileTxt(f) );
        BigInteger message = fileData.modPow( this.decryptionKey, this.modulusN );
        setFileTxt( f, bigIntToChars( message ) );

    }

    public void encryptFile (String fileURL) throws IOException {
        BigInteger fileData = concatenate( getFileTxt(fileURL) );
        BigInteger message = fileData.modPow( this.encryptionKey, this.modulusN );
        setFileTxt( new File(fileURL), bigIntToChars( message ) );

